{
  "name": "Depth",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#9cc2e8"
      }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown"],
      "settings": {
        "foreground": "#9cc2e8"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4d6fa8"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#7fdb7a"
      }
    },
    {
      "name": "String escape sequence",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#5ec4ff"
      }
    },
    {
      "name": "Regexp",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#e8d44d"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "name": "User-defined constant",
      "scope": ["constant.character", "constant.other"],
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "foreground": "#b8d4f0"
      }
    },
    {
      "name": "Variable constant",
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "name": "Keyword, control flow",
      "scope": "keyword.control",
      "settings": {
        "foreground": "#6699ff"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#5fd75f"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#a8c5e8"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#4fc1e9"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c586c0"
      }
    },
    {
      "name": "Class name",
      "scope": ["entity.name.class", "entity.name.type", "entity.name.namespace", "entity.name.scope-resolution"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#ffd479"
      }
    },
    {
      "name": "Inherited class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#ddbb88"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffe066"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#ffe066"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7ab8ff"
      }
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#6699ff"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#8ce99a"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#c586c0"
      }
    },
    {
      "name": "Library constant",
      "scope": "support.constant",
      "settings": {
        "fontStyle": "",
        "foreground": "#b388ff"
      }
    },
    {
      "name": "Library class/type",
      "scope": ["support.type", "support.class"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Library variable",
      "scope": "support.other.variable",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.definition", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#7a9bc4"
      }
    },
    {
      "name": "Punctuation - brackets",
      "scope": ["punctuation.definition.block", "meta.brace"],
      "settings": {
        "foreground": "#a8c5e8"
      }
    },
    {
      "name": "Object / property key",
      "scope": ["meta.object-literal.key", "support.type.property-name", "variable.other.property", "variable.other.object.property"],
      "settings": {
        "foreground": "#8ce99a"
      }
    },
    {
      "name": "This / self",
      "scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c586c0"
      }
    },
    {
      "name": "Decorator / annotation",
      "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e8d44d"
      }
    },
    {
      "name": "Template literal interpolation",
      "scope": ["punctuation.definition.template-expression", "meta.template.expression"],
      "settings": {
        "foreground": "#5ec4ff"
      }
    },
    {
      "name": "Arrow function punctuation",
      "scope": "storage.type.function.arrow",
      "settings": {
        "foreground": "#6699ff"
      }
    },
    {
      "name": "Import / export keywords",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": {
        "foreground": "#6699ff"
      }
    },
    {
      "name": "Type annotations",
      "scope": ["meta.type.annotation", "meta.return-type", "support.type.primitive"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Namespace / module",
      "scope": ["entity.name.module", "entity.name.namespace", "variable.other.readwrite.alias"],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Constant boolean/null",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b388ff"
      }
    },
    {
      "name": "CSS property name",
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "#8ce99a"
      }
    },
    {
      "name": "CSS value / unit",
      "scope": ["constant.numeric.css", "keyword.other.unit"],
      "settings": {
        "foreground": "#b388ff"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff5370"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#ff5370"
      }
    },
    {
      "name": "diff: header",
      "scope": ["meta.diff", "meta.diff.header"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E0EDDD"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff5370"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d44d"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#7fdb7a"
      }
    },
    {
      "name": "Markup Styling",
      "scope": ["markup.bold", "markup.italic"],
      "settings": {
        "foreground": "#7fdb7a"
      }
    },
    {
      "name": "Markup: Strong",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Emphasis",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#c586c0"
      }
    },
    {
      "name": "Markup Headings",
      "scope": ["markup.heading", "markup.heading.setext"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6699ff"
      }
    }
  ],
